// Program 1: Basic Arithmetic Test
// ADDI x1, x0, 10    → x1 = 10     (PC=0x00)
// ADDI x2, x0, 20    → x2 = 20     (PC=0x04)
// ADD  x3, x1, x2    → x3 = 30     (PC=0x08)
// SUB  x4, x2, x1    → x4 = 10     (PC=0x0C)
// AND  x5, x1, x2    → x5 = 0      (PC=0x10)
// OR   x6, x1, x2    → x6 = 30     (PC=0x14)
// NOP                              (PC=0x18)
// JAL  x0, -0x1C     → jump back to PC=0x00 (loop forever)
//
// Encoding:
// ADDI x1, x0, 10  → 00A00093
// ADDI x2, x0, 20  → 01400113
// ADD  x3, x1, x2  → 002081B3  (funct7=0, rs2=x2, rs1=x1, funct3=000, rd=x3, op=0110011)
// SUB  x4, x2, x1  → 40110233  (funct7=0100000)
// AND  x5, x1, x2  → 0020F2B3  (funct3=111)
// OR   x6, x1, x2  → 00206333  (funct3=110)
// NOP (ADDI x0,x0,0) → 00000013
// JAL  x0, -28     → FE5FF06F  imm = -0x1C = -28

00A00093
01400113
002081B3
40110233
0020F2B3
00206333
00000013
FE5FF06F
