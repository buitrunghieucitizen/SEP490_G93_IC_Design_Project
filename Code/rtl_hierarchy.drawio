        </mxCell>
        <mxCell id="24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=18;endArrow=block;endFill=1;fontStyle=0;strokeWidth=2;strokeColor=#000000;fontColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="4" target="12" value="PC operand for AUIPC" vlsit_library_sha256="15DFB183E267D2A94F8CAB316E01EB3D2E9D2F9C006DC816790A394F4123506C" vlsit_library_entry="27" vlsit_library_cell="2" vlsit_library_instance="path_pc_alu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;Block Functions and Interfaces&lt;/b&gt;&lt;br&gt;&lt;br&gt;u_pc / pc (src/pc.v): 32-bit synchronous-reset PC; selects PC+4, branch/JAL target, or masked JALR target.&lt;br&gt;u_inst_mem / instruction_memory (src/instruction_memory.v): parameterized 256 x 32 ROM, asynchronous read, alignment/range checks, program file parameter.&lt;br&gt;u_imm_gen / immediate_gen (src/immediate_gen.v): immediate extraction/sign extension for I/S/B/U/J.&lt;br&gt;u_reg_file / register_file (src/register_file.v): 32 x 32, two asynchronous read ports and one synchronous write; x0 hardwired zero; reset clears registers.&lt;br&gt;u_alu / alu (src/alu.v): required 8 operations plus retained SLT/SLTU extension; decoder issues only required subset.&lt;br&gt;u_data_mem / data_memory (src/data_memory.v): 1024 x 32 byte-addressed RAM; asynchronous read, posedge write, aligned/in-range LW/SW only; DMEM is not reset.&lt;br&gt;&lt;br&gt;Dashed links show functional relationships mediated by datapath logic/nets; there are no separate AXI/APB/valid-ready interfaces." style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" vlsit_library_sha256="15DFB183E267D2A94F8CAB316E01EB3D2E9D2F9C006DC816790A394F4123506C" vlsit_library_entry="32" vlsit_library_cell="2" vlsit_library_instance="panel_l2">
          <mxGeometry width="1760" height="465" as="geometry" x="45" y="485" />
        </mxCell>
      </root>
    </mxGraphModel>
