        <mxCell id="5" value="&lt;b&gt;Block Functions &amp;amp; Interfaces&lt;/b&gt;&lt;br&gt;&lt;br&gt;cpu_top: core integration top (src/cpu_top.v).&lt;br&gt;Inputs: clk, rst. Outputs: debug data taps and sticky fault flags.&lt;br&gt;Clocked state updates on rising edge; PC and RF reset synchronously.&lt;br&gt;Board clock source, reset circuit, device/package, and pin mapping are not specified in RTL." style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" vlsit_library_sha256="15DFB183E267D2A94F8CAB316E01EB3D2E9D2F9C006DC816790A394F4123506C" vlsit_library_entry="32" vlsit_library_cell="2" vlsit_library_instance="panel_top">
