//   [1] addi x2, x0, 3   -> x2 = 3
//   [2] add  x3, x1, x2  -> x3 = 8
//   [3] sub  x4, x1, x2  -> x4 = 2
//   [4] and  x5, x1, x2  -> x5 = 1
//   [5] or   x6, x1, x2  -> x6 = 7
//   [6] xor  x7, x1, x2  -> x7 = 6
//   [7] sw   x3, 0(x0)   -> mem[0] = 8
//   [8] lw   x8, 0(x0)   -> x8 = 8
//   [9] jal  x0, -4      -> loop ve [8]
