{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare simulation output directory",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-Command", "New-Item -ItemType Directory -Force -Path '${workspaceFolder}/out' | Out-Null"],
      "problemMatcher": []
    },
    {
      "label": "Compile ALU test (Verilog-2001)",
      "type": "shell",
      "command": "E:\\down\\iverilog\\bin\\iverilog.exe",
      "args": ["-g2001", "-Wall", "-s", "tb_alu", "-o", "${workspaceFolder}/out/tb_alu.vvp", "${workspaceFolder}/src/alu.v", "${workspaceFolder}/tb/tb_alu.v"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "build",
      "dependsOn": "Prepare simulation output directory",
      "problemMatcher": []
    },
    {
      "label": "Run ALU test",
      "type": "shell",
      "command": "E:\\down\\iverilog\\bin\\vvp.exe",
      "args": ["${workspaceFolder}/out/tb_alu.vvp"],
      "options": {"cwd": "${workspaceFolder}"},
      "dependsOn": "Compile ALU test (Verilog-2001)",
      "problemMatcher": []
    },
    {
      "label": "Compile CPU test (Verilog-2001)",
      "type": "shell",
      "command": "E:\\down\\iverilog\\bin\\iverilog.exe",
      "args": [
        "-g2001", "-Wall", "-s", "tb_cpu", "-o", "${workspaceFolder}/out/tb_cpu.vvp",
        "${workspaceFolder}/src/alu.v", "${workspaceFolder}/src/register_file.v",
        "${workspaceFolder}/src/pc.v", "${workspaceFolder}/src/instruction_memory.v",
        "${workspaceFolder}/src/data_memory.v", "${workspaceFolder}/src/immediate_gen.v",
        "${workspaceFolder}/src/control_unit.v", "${workspaceFolder}/src/datapath.v",
        "${workspaceFolder}/src/cpu_top.v", "${workspaceFolder}/tb/tb_cpu.v"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "dependsOn": "Prepare simulation output directory",
      "problemMatcher": []
    },
    {
      "label": "Run CPU test",
      "type": "shell",
      "command": "E:\\down\\iverilog\\bin\\vvp.exe",
      "args": ["${workspaceFolder}/out/tb_cpu.vvp"],
      "options": {"cwd": "${workspaceFolder}"},
      "dependsOn": "Compile CPU test (Verilog-2001)",
      "problemMatcher": []
    }
  ]
}
